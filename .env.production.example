APP_NAME=Grass Green Nursery
NODE_ENV=production
PORT=8080
TRUST_PROXY=true
CLIENT_ORIGIN=https://your-frontend-domain.com
SERVER_PUBLIC_BASE_URL=https://your-api-domain.com

ACCESS_TOKEN_SECRET=replace-with-64-plus-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-64-plus-random-characters
PASSWORD_RESET_TOKEN_SECRET=replace-with-a-third-64-plus-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_TOKEN_TTL=15m
COOKIE_NAME=ggn_refresh_token
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
AUTH_EXPOSE_DEV_OTP=false

STAFF_BOOTSTRAP_ORGANIZATION_NAME=Shady Plant
STAFF_BOOTSTRAP_ORGANIZATION_SLUG=shady-plant
STAFF_BOOTSTRAP_OWNER_NAME=
STAFF_BOOTSTRAP_OWNER_EMAIL=
STAFF_BOOTSTRAP_OWNER_PASSWORD=
STAFF_ACCESS_TOKEN_SECRET=replace-with-64-plus-random-characters-for-staff
STAFF_COOKIE_NAME=ggn_admin_access_token

POSTGRES_URL=postgres://username:password@your-rds-endpoint:5432/grass_green_nursery
POSTGRES_SSL=true
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
REDIS_URL=rediss://your-elasticache-endpoint:6379
MONGO_URI=mongodb+srv://username:password@your-mongodb-atlas-cluster/grass_green_nursery

SYNC_PRODUCTS_BEARER_TOKEN=replace-with-64-plus-random-characters
SYNC_PRODUCTS_RATE_LIMIT_WINDOW_MS=60000
SYNC_PRODUCTS_RATE_LIMIT_MAX=10
SYNC_PRODUCTS_MAX_BATCH_SIZE=10000
SYNC_PRODUCTS_BULK_WRITE_CHUNK_SIZE=500
SYNC_PRODUCTS_LOCK_TTL_SECONDS=900
SYNC_PRODUCTS_REPLAY_TTL_SECONDS=86400

# Store the full JSON in AWS Secrets Manager, or split it into FIREBASE_PROJECT_ID,
# FIREBASE_CLIENT_EMAIL, and FIREBASE_PRIVATE_KEY.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
GOOGLE_REQUIRED_HOSTED_DOMAIN=
GOOGLE_MAPS_SERVER_API_KEY=

MAILER_TRANSPORT=smtp
MAILER_FROM_NAME=Grass Green Nursery
MAILER_FROM_EMAIL=no-reply@your-domain.com
MAILER_ALIAS_USER=
MAILER_REPLY_TO=support@your-domain.com
MAILER_HOST=smtp.your-provider.com
MAILER_PORT=587
MAILER_SECURE=false
MAILER_USER=
MAILER_PASS=

PAYMENT_GATEWAY_PROVIDER=phonepe
PAYMENT_GATEWAY_MODE=production
PAYMENT_GATEWAY_ORDER_EXPIRE_AFTER_SECONDS=1200
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_VERSION=1
PHONEPE_CLIENT_SECRET=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2025-01-01
