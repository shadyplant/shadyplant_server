APP_NAME=Grass Green Nursery
PORT=8080
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
ACCESS_TOKEN_SECRET=replace-with-a-random-development-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-random-development-secret
PASSWORD_RESET_TOKEN_SECRET=replace-with-a-third-random-development-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d   
PASSWORD_RESET_TOKEN_TTL=15m 
COOKIE_NAME=ggn_refresh_token
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
AUTH_EXPOSE_DEV_OTP=false
STAFF_BOOTSTRAP_ORGANIZATION_NAME=Shady Plant
STAFF_BOOTSTRAP_ORGANIZATION_SLUG=shady-plant
STAFF_BOOTSTRAP_OWNER_NAME=Local Owner
STAFF_BOOTSTRAP_OWNER_EMAIL=owner@example.local
STAFF_BOOTSTRAP_OWNER_PASSWORD=replace-with-local-owner-password
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/grass_green_nursery
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://localhost:27017/grass_green_nursery
SYNC_PRODUCTS_BEARER_TOKEN=replace-with-product-sync-token
SYNC_PRODUCTS_RATE_LIMIT_WINDOW_MS=60000
SYNC_PRODUCTS_RATE_LIMIT_MAX=10
SYNC_PRODUCTS_MAX_BATCH_SIZE=10000
SYNC_PRODUCTS_BULK_WRITE_CHUNK_SIZE=500
SYNC_PRODUCTS_LOCK_TTL_SECONDS=900
SYNC_PRODUCTS_REPLAY_TTL_SECONDS=86400
# Local only: prefer FIREBASE_SERVICE_ACCOUNT_JSON or FIREBASE_* values in production.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
GOOGLE_REQUIRED_HOSTED_DOMAIN=
MAILER_TRANSPORT=smtp
MAILER_FROM_NAME=Grass Green Nursery
MAILER_FROM_EMAIL=no-reply@example.local
MAILER_ALIAS_USER=
MAILER_REPLY_TO=
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_SECURE=false
MAILER_USER=
MAILER_PASS=

# ---------------------------------------------------------------------------------
#                                   PAYMENT GATEWAY START
# ---------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=phonepe
PAYMENT_GATEWAY_MODE=sandbox
PAYMENT_GATEWAY_ORDER_EXPIRE_AFTER_SECONDS=1200
SERVER_PUBLIC_BASE_URL=http://localhost:8080
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_VERSION=1
PHONEPE_CLIENT_SECRET=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2025-01-01
# ---------------------------------------------------------------------------------
#                                   PAYMENT GATEWAY END
# ---------------------------------------------------------------------------------
